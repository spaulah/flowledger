# Copy this file to .env and fill in your values. Never commit .env.

# --- Chat and embeddings (any OpenAI-compatible API, or Azure OpenAI) ---
# LLM_PROVIDER: "openai" for any OpenAI-compatible API (OpenAI, Ollama, LM Studio,
#   vLLM, ...), or "azure" for Azure OpenAI / Azure AI Foundry.
#   If unset, Azure is detected from the host name.
# LLM_BASE_URL: the endpoint. For openai, "/v1" is appended if missing.
#   Examples: https://api.openai.com   http://localhost:11434 (Ollama)
# LLM_API_KEY: required for Azure. Optional for local servers that need none.
# LLM_MODEL: chat model name, or the deployment name on Azure.
# EMBEDDING_MODEL: embedding model name, or the deployment name on Azure.
#   Changing it requires rebuilding the index (see README).
# LLM_AZURE_API_VERSION: only for Azure. Default 2024-02-01.
#
# Embeddings use the same LLM_BASE_URL and LLM_API_KEY as chat.
# The older AZURE_AI_INFERENCE_* and AZURE_AI_EMBEDDINGS_MODEL names still work,
# with a deprecation warning.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# LLM_AZURE_API_VERSION=2024-02-01

# --- Power Platform service principal (used by jobs/download_flows.py) ---
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# --- Optional logging ---
# LOG_LEVEL: INFO (default) or DEBUG. DEBUG also shows HTTP request lines (with endpoint URLs)
# and environment IDs. Do not share DEBUG output.
# LOG_LEVEL=INFO

# --- Optional paths (defaults shown) ---
# Local data lives in the git-ignored .flow-data/ folder by default.
# FLOW_DEFINITIONS_PATH=.flow-data/flow_exports
# CHROMA_DB_PATH=.flow-data/chroma_db

# --- Optional run details ---
# Runs per flow to download action-level inputs and outputs for (most recent, failed first).
# 0 turns it off. Default 25.
# FLOW_RUN_DETAILS_LIMIT=25
